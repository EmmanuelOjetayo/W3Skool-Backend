# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/w3skool
# Production: mongodb+srv://<user>:<password>@<cluster>/w3skool?retryWrites=true&w=majority
MONGO_URI=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Frontend origins (comma separated for multiple, e.g. a Render site + local) ----
CLIENT_URL=http://localhost:3000

# ---- Public API URL (used in certificate emails / verification links) ----
API_PUBLIC_URL=http://localhost:5000

# ---- Payments (Flutterwave) ----
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_PLATFORM_FEE_PCT=1.5
PLATFORM_SPLIT_PERCENT=70

# ---- Email (Brevo) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=W3Skool

# ---- Certificate storage: cloudinary | local ----
CERT_STORAGE=cloudinary

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=